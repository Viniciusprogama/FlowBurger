# --- VeoPag (obrigatorio em producao) ---
VEOPAG_BASE_URL=https://api.veopag.com
VEOPAG_CLIENT_ID=
VEOPAG_CLIENT_SECRET=
# Segredo "Webhook Signature" do portal: https://dashboard.veopag.com/webhooks
VEOPAG_WEBHOOK_SECRET=
# Token do cabecalho Authorization: Bearer do webhook (opcional, se configurado no portal)
VEOPAG_CALLBACK_TOKEN=
# URL publica que a VeoPag chama (endpoint /api/webhooks/veopag/deposit)
# Local: http://localhost:4017/api/webhooks/veopag/deposit
# Vercel: https://SEU-DOMINIO.vercel.app/api/webhooks/veopag/deposit
VEOPAG_CALLBACK_URL=http://localhost:4017/api/webhooks/veopag/deposit

# --- Servidor ---
PORT=4017
HOST=127.0.0.1
# Raiz do site estatico (relativo a pasta server/). Vazio = serve ../www.flowburger.shop
STATIC_DIR=
# URL do site para links/cors
APP_URL=http://localhost:4017
# Origens liberadas no CORS (separadas por virgula). Vazio = nenhuma (mesma origem).
# Local: 127.0.0.1:5503
# Vercel: https://SEU-DOMINIO.vercel.app
CORS_ORIGINS=http://127.0.0.1:5503,http://localhost:5503

# --- Banco ---
# Local: caminho do arquivo SQLite
# Vercel/Producao: URL do Postgres (Supabase, Vercel Postgres, etc)
#   postgresql://user:pass@host:5432/dbname
DATABASE_URL=./data/flowburger.db

# --- Seguranca ---
# Token do endpoint administrativo /api/admin/orders
ADMIN_TOKEN=
# 1 = exigir CPF/CNPJ do pagador no pedido (recomendado em producao)
REQUIRE_PAYER_DOCUMENT=0

# --- Pedidos ---
# Validade do Pix/QR Code em minutos (a VeoPag nao documenta TTL proprio)
ORDER_EXPIRY_MINUTES=30
# Taxa de entrega em reais (0 = gratis)
DELIVERY_FEE=0
# Prazo estimado exibido ao cliente apos confirmacao (texto livre)
PREPARO_ESTIMADO=30 a 40 minutos

# --- Logs ---
# debug | info | warn | error
LOG_LEVEL=info

# --- Vercel (producao) ---
# Definido automaticamente pelo Vercel:
#   VERCEL=1
#   VERCEL_ENV=production|preview|development
#   VERCEL_URL=SEU-DOMINIO.vercel.app
