{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static", "config": { "includeFiles": ["!api/**", "!src/**", "!tests/**", "!docs/**", "!scripts/**", "!data/**", "!*.md"] } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "memory": 512, "maxDuration": 30 }
  }
}
